# From Edesy dashboard > API Credentials
EDESY_ACCOUNT_SID=your-account-sid
EDESY_AUTH_TOKEN=your-auth-token
# A number you bought on Edesy (E.164)
EDESY_FROM_NUMBER=+9180XXXXXXXX

# Public https URL of THIS server (ngrok / VPS). Edesy must reach it.
PUBLIC_BASE_URL=https://your-name.ngrok-free.app

PORT=3000
CONCURRENCY=5
# Protects the dashboard/API. Open the dashboard as /?key=YOUR_TOKEN
ADMIN_TOKEN=change-me
